root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

# Fixtures are verbatim copies of kernel/sysfs output; keep them byte-exact.
[**/testdata/**]
trim_trailing_whitespace = false
insert_final_newline = unset
